{
  "manifest_version": 3,
  "name": "Bookmark Board",
  "version": "0.1.0",
  "description": "A simple, native bookmark board for Chromium new tabs.",
  "icons": {
    "16": "icons/bookmark-board-16.png",
    "32": "icons/bookmark-board-32.png",
    "48": "icons/bookmark-board-48.png",
    "128": "icons/bookmark-board-128.png"
  },
  "permissions": ["bookmarks", "storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Open Bookmark Board",
    "default_icon": {
      "16": "icons/bookmark-board-16.png",
      "32": "icons/bookmark-board-32.png",
      "48": "icons/bookmark-board-48.png",
      "128": "icons/bookmark-board-128.png"
    }
  }
}
